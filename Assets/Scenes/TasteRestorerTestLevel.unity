    enableRatio: 0
    enableCombination: 0
    enableForce: 0
    enableSpeed: 0
    enableGrindDuration: 0
  feedbackTexts:
    forceTooLight: Grinding force is too light.
    forceTooHeavy: Grinding force is too heavy.
    forceCorrect: Grinding force is correct.
    speedTooSlow: Grinding speed is too slow.
    speedTooFast: Grinding speed is too fast.
    speedCorrect: Grinding speed is correct.
    durationTooShort: Grinding duration is too short.
    durationCorrect: Grinding duration is correct.
    durationTooLong: Grinding duration is too long.
    selectionCorrect: Ingredient selection is correct.
    selectionWrong: Ingredient selection does not match the target.
    orderCorrect: Ingredient order is correct.
    orderPartial: Ingredient order is partially correct.
    orderWrong: Ingredient order does not match the target.
    ratioCorrect: Ratio pattern is correct.
    ratioAmbiguous: Ratio pattern is still ambiguous.
    combinationCorrect: Combination pattern is correct.
    combinationWrong: Combination pattern does not match the target.
  hintSettings:
