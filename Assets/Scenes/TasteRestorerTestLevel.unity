  levelID: L05
  levelName: Tangerine Red Bean Sweetness
  cityName: Jiangmen
  targetTasteName: Order Tutorial
  levelIntro: 'Fifth lesson: ingredient order. Red bean builds the base, dried tangerine
    peel lifts the middle aroma, and rock sugar rounds the finish. Wrong order can
    let sweetness or bitterness cover the body.'
  maxIngredientCount: 3
  availableIngredients:
  - {fileID: 345734362}
  - {fileID: 572168203}
  - {fileID: 1919107170}
