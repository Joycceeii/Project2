    ingredientSelection: 20
    ingredientOrder: 15
    ratio: 20
    combination: 15
    force: 10
    speed: 10
    grindDuration: 10
  unlockCluesOnComplete:
  - clueId: L05_RedBean_Order
    title: Red Bean - Order Clue
    content: Red bean works well early because it builds the base body.
    relatedIngredients:
    - {fileID: 345734362}
    relatedDimension: 1
  - clueId: L05_Peel_Order
    title: Dried Tangerine Peel - Order Clue
    content: Dried tangerine peel works better later. Too early can release bitterness.
    relatedIngredients:
    - {fileID: 572168203}
    relatedDimension: 1
  - clueId: L05_RockSugar_Order
    title: Rock Sugar - Order Clue
    content: Rock Sugar works best at the end to round sweetness.
    relatedIngredients:
    - {fileID: 1919107170}
    relatedDimension: 1
  processFeedbackRules: []
  fallbackHintText: No new experiment conclusion is available yet. Keep the parts
    that are already correct and adjust only one uncertain mechanic at a time.
  progressiveHintRules:
  - ruleId: L05_Hint_RedBean_Order
    priority: 22
    mechanic: 1
    hintText: The thick red bean aroma should form the base first. Place red bean
      before dried tangerine peel and rock sugar.
  - ruleId: L05_Hint_Peel_Order
    priority: 21
    mechanic: 1
    hintText: Dried tangerine peel is appearing too early. It should be later so
      bitterness does not cover the bean aroma.
  - ruleId: L05_Hint_RockSugar_Order
    priority: 20
    mechanic: 1
    hintText: Sweetness should not take the lead. Add rock sugar last to round the
      finish.
  successFeedback: The red bean body opens first, dried tangerine peel lifts the
    middle, and rock sugar gives a clean warm finish.
  closeFeedback: The flavor is layered, but one note is out of order. Red bean should
    be early, and the finishing note should arrive later.
  wrongFeedback: Bitterness, sweetness, or peel aroma appears before the red bean
    body. The order is disrupted.
