  - {fileID: 1778564978}
  - {fileID: 572168203}
  forbiddenIngredients: []
  unlockedDimensions: 040000000200000006000000
  lockedDimensions: 050000000300000001000000
  correctIngredientOrder:
  - {fileID: 185727215}
  - {fileID: 572168203}
  - {fileID: 1778564978}
  correctRatioPattern:
  - ingredient: {fileID: 185727215}
    ratioLevel: 5
  - ingredient: {fileID: 572168203}
    ratioLevel: 4
  - ingredient: {fileID: 1778564978}
    ratioLevel: 2
  correctCombinationPattern:
    groups:
    - ingredients:
      - {fileID: 185727215}
    - ingredients:
      - {fileID: 572168203}
    - ingredients:
      - {fileID: 1778564978}
  targetForceLevel: 2
  targetSpeedLevel: 1
  minGrindDuration: 20
  maxGrindDuration: 32
  passingScore: 90
  enabledMechanics:
    enableIngredientSelection: 0
    enableIngredientOrder: 0
    enableRatio: 1
    enableCombination: 0
    enableForce: 1
    enableSpeed: 0
    enableGrindDuration: 1
  feedbackTexts:
    forceTooLight: Grinding force is too light.
    forceTooHeavy: Grinding force is too heavy.
    forceCorrect: Grinding force is correct.
    speedTooSlow: Grinding speed is too slow.
    speedTooFast: Grinding speed is too fast.
    speedCorrect: Grinding speed is correct.
    durationTooShort: Grinding duration is too short.
    durationCorrect: Grinding duration is correct.
    durationTooLong: Grinding duration is too long.
    selectionCorrect: Ingredient selection is correct.
    selectionWrong: Ingredient selection does not match the target.
    orderCorrect: Ingredient order is correct.
    orderPartial: Ingredient order is partially correct.
    orderWrong: Ingredient order does not match the target.
    ratioCorrect: Ratio pattern is correct.
    ratioAmbiguous: Ratio pattern is still ambiguous.
    combinationCorrect: Combination pattern is correct.
    combinationWrong: Combination pattern does not match the target.
  hintSettings:
    hintPriority: 0200000004000000
    maxOrderHints: 5
    maxRatioHints: 5
    maxCombinationHints: 3
    maxProcessHints: 2
  scoringWeights:
    ingredientSelection: 20
    ingredientOrder: 15
    ratio: 20
    combination: 15
    force: 10
    speed: 10
    grindDuration: 10
  unlockCluesOnComplete:
  - clueId: L06_SandGinger_Force
    title: Sand Ginger - Force Clue
    content: Sand ginger likes MediumHigh force. Too light leaves it closed; too
      heavy makes it harsh.
    relatedIngredients:
    - {fileID: 185727215}
    relatedDimension: 4
  - clueId: L06_CoarseSalt_Ratio
    title: Coarse Salt - Ratio Clue
    content: Coarse salt should be used sparingly as support, not as the main note.
    relatedIngredients:
    - {fileID: 1778564978}
    relatedDimension: 2
  processFeedbackRules:
  - ruleId: L06_Process_Force_Wrong
    priority: 30
    requiredCorrect:
    requiredIncorrect: 04000000
    hintText: Sand ginger has not opened correctly yet. Use MediumHigh force, but
      do not push it to Heavy.
  - ruleId: L06_Process_Duration_Wrong
    priority: 25
    requiredCorrect:
    requiredIncorrect: 06000000
    hintText: The grinding duration is not right for the salt-baked sand ginger structure
      yet.
  - ruleId: L06_Process_All_Correct
    priority: 1
    requiredCorrect: 0400000006000000
    requiredIncorrect:
    hintText: The process is correct. Keep MediumHigh force and check the ratio.
  fallbackHintText: No new experiment conclusion is available yet. Keep the parts
    that are already correct and adjust only one uncertain mechanic at a time.
  progressiveHintRules:
  - ruleId: L06_Hint_SandGinger_Ratio
    priority: 22
    mechanic: 2
    hintText: Sand ginger is the core of the salt-baked powder. It must have the
      highest ratio.
  - ruleId: L06_Hint_CoarseSalt_Ratio
    priority: 21
    mechanic: 2
    hintText: Salt is covering the spice. Coarse salt should be the lowest support
      note.
  - ruleId: L06_Hint_Peel_Ratio
    priority: 20
    mechanic: 2
    hintText: Dried peel is only a light finish, but it should still be more visible
      than coarse salt.
  successFeedback: Sand ginger opens clearly, dried peel brightens the finish, and
    coarse salt supports from below.
  closeFeedback: The sand ginger direction is right, but force or ratio is still
    unstable.
  wrongFeedback: Salt or citrus takes the front, and sand ginger does not open as
    the core aroma.
