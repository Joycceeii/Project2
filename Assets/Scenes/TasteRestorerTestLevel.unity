  m_Name:
  m_EditorClassIdentifier:
  levelID: L09
  levelName: Douchi Steamed Fish
  cityName: Yangjiang
  targetTasteName: Four-Dimension Challenge
  levelIntro: Force, speed, ratio, order, and duration are unlocked. Yangjiang douchi
    should become the savory core, with ginger in the middle and peel cleaning the
    finish.
  maxIngredientCount: 4
  availableIngredients:
  - {fileID: 1608869541}
  - {fileID: 1870811157}
  - {fileID: 572168203}
  - {fileID: 1778564978}
  requiredIngredients:
  - {fileID: 1608869541}
  - {fileID: 1870811157}
  - {fileID: 572168203}
  - {fileID: 1778564978}
  forbiddenIngredients: []
  unlockedDimensions: 0400000005000000020000000100000006000000
  lockedDimensions: 03000000
  correctIngredientOrder:
  - {fileID: 1608869541}
  - {fileID: 1870811157}
  - {fileID: 1778564978}
  - {fileID: 572168203}
  correctRatioPattern:
  - ingredient: {fileID: 1608869541}
    ratioLevel: 5
  - ingredient: {fileID: 1870811157}
    ratioLevel: 4
  - ingredient: {fileID: 572168203}
    ratioLevel: 2
  - ingredient: {fileID: 1778564978}
    ratioLevel: 1
  correctCombinationPattern:
    groups:
    - ingredients:
      - {fileID: 1608869541}
    - ingredients:
      - {fileID: 1870811157}
    - ingredients:
      - {fileID: 572168203}
    - ingredients:
      - {fileID: 1778564978}
  targetForceLevel: 1
  targetSpeedLevel: 1
  minGrindDuration: 28
  maxGrindDuration: 45
  passingScore: 90
  enabledMechanics:
    enableIngredientSelection: 0
    enableIngredientOrder: 1
    enableRatio: 1
    enableCombination: 0
    enableForce: 1
    enableSpeed: 1
    enableGrindDuration: 1
  feedbackTexts:
    forceTooLight: Grinding force is too light.
    forceTooHeavy: Grinding force is too heavy.
    forceCorrect: Grinding force is correct.
    speedTooSlow: Grinding speed is too slow.
    speedTooFast: Grinding speed is too fast.
    speedCorrect: Grinding speed is correct.
    durationTooShort: Grinding duration is too short.
    durationCorrect: Grinding duration is correct.
    durationTooLong: Grinding duration is too long.
    selectionCorrect: Ingredient selection is correct.
    selectionWrong: Ingredient selection does not match the target.
    orderCorrect: Ingredient order is correct.
    orderPartial: Ingredient order is partially correct.
    orderWrong: Ingredient order does not match the target.
    ratioCorrect: Ratio pattern is correct.
    ratioAmbiguous: Ratio pattern is still ambiguous.
    combinationCorrect: Combination pattern is correct.
    combinationWrong: Combination pattern does not match the target.
  hintSettings:
    hintPriority: 01000000020000000500000004000000
    maxOrderHints: 5
    maxRatioHints: 5
    maxCombinationHints: 3
    maxProcessHints: 2
  scoringWeights:
    ingredientSelection: 20
    ingredientOrder: 15
    ratio: 20
    combination: 15
    force: 10
    speed: 10
    grindDuration: 10
  unlockCluesOnComplete:
  - clueId: L09_Douchi_Force
    title: Yangjiang Douchi - Force Clue
    content: Yangjiang douchi likes Medium force. Too light keeps it closed; too
      heavy makes fermentation dull or muddy.
    relatedIngredients:
    - {fileID: 1608869541}
    relatedDimension: 4
  - clueId: L09_Douchi_Ratio
    title: Yangjiang Douchi - Ratio Clue
    content: Yangjiang douchi can lead the savory aroma, but too much makes the structure
      heavy.
    relatedIngredients:
    - {fileID: 1608869541}
    relatedDimension: 2
  - clueId: L09_Ginger_Speed
    title: Ginger - Speed Clue
    content: Ginger works best at Medium speed. Too fast makes the spice rush forward.
    relatedIngredients:
    - {fileID: 1870811157}
    relatedDimension: 5
  - clueId: L09_Ginger_Order
    title: Ginger - Order Clue
    content: Ginger works well in the middle, opening freshness after the main body
      is established.
    relatedIngredients:
    - {fileID: 1870811157}
    relatedDimension: 1
  processFeedbackRules:
  - ruleId: L09_Process_Force_Wrong
    priority: 30
    requiredCorrect:
    requiredIncorrect: 04000000
    hintText: Yangjiang douchi is not opening correctly yet. Use Medium force; too
      light stays closed and too heavy turns muddy.
  - ruleId: L09_Process_Speed_Wrong
    priority: 25
    requiredCorrect:
    requiredIncorrect: 05000000
    hintText: Ginger is releasing at the wrong pace. Adjust the pestle movement to
      Medium speed.
  - ruleId: L09_Process_Duration_Wrong
    priority: 20
    requiredCorrect:
    requiredIncorrect: 06000000
    hintText: The grinding duration is not right for the douchi structure yet.
  - ruleId: L09_Process_All_Correct
    priority: 1
    requiredCorrect: 040000000500000006000000
    requiredIncorrect:
    hintText: The force, speed, and duration are correct. Continue checking ratio
      and order.
  fallbackHintText: No new experiment conclusion is available yet. Keep the parts
    that are already correct and adjust only one uncertain mechanic at a time.
  progressiveHintRules:
  - ruleId: L09_Hint_Douchi_Ratio
    priority: 22
    mechanic: 2
    hintText: Yangjiang douchi must carry the savory main body, so it should have
      the highest ratio.
  - ruleId: L09_Hint_CoarseSalt_Ratio
    priority: 21
    mechanic: 2
    hintText: Coarse salt is only support and should stay at the lowest ratio.
  - ruleId: L09_Hint_Douchi_Order
    priority: 22
    mechanic: 1
    hintText: Build the fermented savory base with douchi first.
  - ruleId: L09_Hint_Ginger_Order
    priority: 21
    mechanic: 1
    hintText: Ginger works in the middle, after douchi and before the finishing peel.
  - ruleId: L09_Hint_Tail_Order
    priority: 20
    mechanic: 1
    hintText: Dried peel cleans the finish, while coarse salt is only a small base
      correction.
  successFeedback: Douchi becomes the savory core, ginger opens freshness, salt supports,
    and peel cleans the finish.
  closeFeedback: The douchi body is present, but ginger, salt, or peel still needs
    a better position.
  wrongFeedback: Salt is too heavy, ginger is too sharp, or peel bitterness arrives
    too early.
