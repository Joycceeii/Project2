  m_Name:
  m_EditorClassIdentifier:
  levelID: L01
  levelName: Rice Porridge Aroma
  cityName: Guangzhou
  targetTasteName: Force Tutorial
  levelIntro: 'First lesson: grinding force. Rice has a gentle grain aroma that needs
    even pressure. Too light leaves it closed; too heavy overheats the powder and
    creates scorched notes.'
  maxIngredientCount: 1
  availableIngredients:
  - {fileID: 2039003237}
  requiredIngredients:
  - {fileID: 2039003237}
  forbiddenIngredients: []
  unlockedDimensions: 0400000006000000
  lockedDimensions: 05000000020000000300000001000000
  correctIngredientOrder:
  - {fileID: 2039003237}
  correctRatioPattern:
  - ingredient: {fileID: 2039003237}
    ratioLevel: 3
  correctCombinationPattern:
    groups:
    - ingredients:
      - {fileID: 2039003237}
  targetForceLevel: 1
  targetSpeedLevel: 1
  minGrindDuration: 8
  maxGrindDuration: 14
  passingScore: 100
  enabledMechanics:
    enableIngredientSelection: 0
    enableIngredientOrder: 0
    enableRatio: 0
    enableCombination: 0
    enableForce: 1
    enableSpeed: 0
    enableGrindDuration: 1
  feedbackTexts:
    forceTooLight: Grinding force is too light.
    forceTooHeavy: Grinding force is too heavy.
    forceCorrect: Grinding force is correct.
    speedTooSlow: Grinding speed is too slow.
    speedTooFast: Grinding speed is too fast.
    speedCorrect: Grinding speed is correct.
    durationTooShort: Grinding duration is too short.
    durationCorrect: Grinding duration is correct.
    durationTooLong: Grinding duration is too long.
    selectionCorrect: Ingredient selection is correct.
    selectionWrong: Ingredient selection does not match the target.
    orderCorrect: Ingredient order is correct.
    orderPartial: Ingredient order is partially correct.
    orderWrong: Ingredient order does not match the target.
    ratioCorrect: Ratio pattern is correct.
    ratioAmbiguous: Ratio pattern is still ambiguous.
    combinationCorrect: Combination pattern is correct.
    combinationWrong: Combination pattern does not match the target.
  hintSettings:
    hintPriority: 04000000
    maxOrderHints: 5
    maxRatioHints: 5
    maxCombinationHints: 3
    maxProcessHints: 2
  scoringWeights:
    ingredientSelection: 20
    ingredientOrder: 15
    ratio: 20
    combination: 15
    force: 10
    speed: 10
    grindDuration: 10
  unlockCluesOnComplete:
  - clueId: L01_Rice_Force
    title: Rice - Force Clue
    content: Rice works best with medium force. Too light keeps the aroma closed;
      too heavy heats the powder and creates scorched notes.
    relatedIngredients:
    - {fileID: 2039003237}
    relatedDimension: 4
  processFeedbackRules:
  - ruleId: L01_Process_Force_Wrong
    priority: 30
    requiredCorrect:
    requiredIncorrect: 04000000
    hintText: 'The force is not right for rice yet. Keep the slider near Medium:
      too light leaves grains closed, while too heavy creates heat.'
  - ruleId: L01_Process_Duration_Wrong
    priority: 25
    requiredCorrect:
    requiredIncorrect: 06000000
    hintText: The grinding time is not right yet. Rice needs enough time to become
      fine, but overgrinding creates heat.
  - ruleId: L01_Process_All_Correct
    priority: 1
    requiredCorrect: 0400000006000000
    requiredIncorrect:
    hintText: The force and duration are correct. Keep this process.
  fallbackHintText: No new experiment conclusion is available yet. Keep the parts
    that are already correct and adjust only one uncertain mechanic at a time.
  progressiveHintRules:
  - ruleId: L01_Hint_Force
    priority: 20
    mechanic: 4
    hintText: Rice is gentle and does not need maximum force. Try keeping the force
      near the middle of the slider.
  successFeedback: A soft rice aroma spreads from the scent paper, like a fresh pot
    of morning porridge. The grains feel fine, the smell is clean and sweet, and
    the restoration is complete.
  closeFeedback: The rice aroma is present, but it still feels dull or slightly heated.
    The direction is close; refine the grinding process.
  wrongFeedback: The rice aroma was not released correctly. Too light leaves hard
    grains; too heavy or too long creates hot, scorched notes.
