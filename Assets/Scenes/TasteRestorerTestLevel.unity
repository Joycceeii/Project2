    groups:
    - ingredients:
      - {fileID: 345734362}
    - ingredients:
      - {fileID: 572168203}
    - ingredients:
      - {fileID: 1919107170}
  targetForceLevel: 1
  targetSpeedLevel: 1
  minGrindDuration: 18
  maxGrindDuration: 28
