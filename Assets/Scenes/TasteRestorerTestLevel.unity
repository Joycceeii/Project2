  cityName: Meizhou
  targetTasteName: Two-Dimension Challenge
  levelIntro: Force and ratio are unlocked. Sand ginger must open as the core aroma
    while coarse salt stays supportive and dried tangerine peel cleans the finish.
  maxIngredientCount: 3
  availableIngredients:
  - {fileID: 185727215}
  - {fileID: 1778564978}
  - {fileID: 572168203}
  requiredIngredients:
