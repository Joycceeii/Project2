    ratioAmbiguous: Ratio pattern is still ambiguous.
    combinationCorrect: Combination pattern is correct.
    combinationWrong: Combination pattern does not match the target.
  hintSettings:
    hintPriority: 05000000
    maxOrderHints: 5
    maxRatioHints: 5
    maxCombinationHints: 3
    maxProcessHints: 2
  scoringWeights:
    ingredientSelection: 20
    ingredientOrder: 15
    ratio: 20
    combination: 15
    force: 10
    speed: 10
    grindDuration: 10
  unlockCluesOnComplete:
  - clueId: L02_Tea_Speed
    title: Tea Leaf - Speed Clue
    content: Tea leaf works best with slow grinding. Fast grinding releases bitterness
      before sweetness.
    relatedIngredients:
    - {fileID: 1016333429}
    relatedDimension: 5
  processFeedbackRules:
  - ruleId: L02_Process_Speed_Wrong
    priority: 30
    requiredCorrect:
    requiredIncorrect: 05000000
    hintText: The speed is not right for tea yet. Keep it Slow so bitterness does
      not rush out before the sweet return.
  - ruleId: L02_Process_Duration_Wrong
    priority: 25
    requiredCorrect:
    requiredIncorrect: 06000000
    hintText: Slow grinding does not mean endless grinding. Too much time still builds
      bitterness.
  - ruleId: L02_Process_All_Correct
    priority: 1
    requiredCorrect: 0500000006000000
    requiredIncorrect:
    hintText: The speed and duration are correct. Keep Slow and avoid sudden acceleration.
  fallbackHintText: No new experiment conclusion is available yet. Keep the parts
    that are already correct and adjust only one uncertain mechanic at a time.
  progressiveHintRules:
  - ruleId: L02_Hint_Speed
    priority: 20
    mechanic: 5
    hintText: Tea needs time for the sweet return to appear. Set the grinding speed
      to Slow.
  successFeedback: 'The tea aroma opens slowly: first a clean bitterness, then a
    soft sweet return with stable layers.'
  closeFeedback: The sweet return appears, but bitterness still arrives too early
    or too strongly. The speed is close; slow down or shorten the process a little.
  wrongFeedback: Bitterness bursts out and covers the tea aroma. The grinding speed
    is too fast or the process lasted too long.
