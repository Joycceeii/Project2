  targetTasteName: Speed Tutorial
  levelIntro: 'Second lesson: grinding speed. Tea leaf carries bitterness and sweet
    return. If the speed is too fast, bitterness rushes out first and hides the later
    sweetness.'
  maxIngredientCount: 1
  availableIngredients:
  - {fileID: 1016333429}
