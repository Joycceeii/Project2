  m_Script: {fileID: 11500000, guid: 93d77098594300848a3dd7d79496bee5, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  levelID: L10
  levelName: Ginger Scallion Dipping Sauce
  cityName: Zhanjiang
  targetTasteName: Final Free Challenge
  levelIntro: All core dimensions are unlocked. Restore the full ginger-scallion
    dipping sauce structure with a salt base, sand ginger body, ginger freshness,
    and scallion finish.
  maxIngredientCount: 4
  availableIngredients:
  - {fileID: 185727215}
  - {fileID: 1870811157}
  - {fileID: 126495275}
  - {fileID: 1778564978}
  requiredIngredients:
  - {fileID: 185727215}
  - {fileID: 1870811157}
  - {fileID: 126495275}
  - {fileID: 1778564978}
  forbiddenIngredients: []
  unlockedDimensions: 040000000500000002000000030000000100000006000000
  lockedDimensions:
  correctIngredientOrder:
  - {fileID: 1778564978}
  - {fileID: 185727215}
  - {fileID: 1870811157}
  - {fileID: 126495275}
  correctRatioPattern:
  - ingredient: {fileID: 185727215}
    ratioLevel: 5
  - ingredient: {fileID: 1870811157}
    ratioLevel: 4
  - ingredient: {fileID: 126495275}
    ratioLevel: 2
  - ingredient: {fileID: 1778564978}
    ratioLevel: 1
  correctCombinationPattern:
    groups:
    - ingredients:
      - {fileID: 185727215}
      - {fileID: 1870811157}
    - ingredients:
      - {fileID: 126495275}
    - ingredients:
      - {fileID: 1778564978}
  targetForceLevel: 2
  targetSpeedLevel: 1
  minGrindDuration: 30
  maxGrindDuration: 50
  passingScore: 90
  enabledMechanics:
    enableIngredientSelection: 0
    enableIngredientOrder: 1
    enableRatio: 1
    enableCombination: 1
    enableForce: 1
    enableSpeed: 1
    enableGrindDuration: 1
  feedbackTexts:
    forceTooLight: Grinding force is too light.
    forceTooHeavy: Grinding force is too heavy.
    forceCorrect: Grinding force is correct.
    speedTooSlow: Grinding speed is too slow.
    speedTooFast: Grinding speed is too fast.
    speedCorrect: Grinding speed is correct.
    durationTooShort: Grinding duration is too short.
    durationCorrect: Grinding duration is correct.
    durationTooLong: Grinding duration is too long.
    selectionCorrect: Ingredient selection is correct.
    selectionWrong: Ingredient selection does not match the target.
    orderCorrect: Ingredient order is correct.
    orderPartial: Ingredient order is partially correct.
    orderWrong: Ingredient order does not match the target.
    ratioCorrect: Ratio pattern is correct.
    ratioAmbiguous: Ratio pattern is still ambiguous.
    combinationCorrect: Combination pattern is correct.
    combinationWrong: Combination pattern does not match the target.
  hintSettings:
    hintPriority: 0100000002000000030000000500000004000000
    maxOrderHints: 5
    maxRatioHints: 5
    maxCombinationHints: 3
    maxProcessHints: 2
  scoringWeights:
    ingredientSelection: 20
    ingredientOrder: 15
    ratio: 20
    combination: 15
    force: 10
    speed: 10
    grindDuration: 10
  unlockCluesOnComplete:
  - clueId: L10_Ginger_Combination
    title: Ginger Combination Clue
    content: Sand ginger and ginger can be partly ground together so the main ginger
      body and fresh spice connect naturally.
    relatedIngredients:
    - {fileID: 185727215}
    - {fileID: 1870811157}
    relatedDimension: 3
  - clueId: L10_Scallion_Order
    title: Scallion White - Order Clue
    content: Scallion white works best at the end and should not be overground with
      strong spicy ingredients.
    relatedIngredients:
    - {fileID: 126495275}
    relatedDimension: 1
  processFeedbackRules:
  - ruleId: L10_Process_Force_Wrong
    priority: 30
    requiredCorrect:
    requiredIncorrect: 04000000
    hintText: Sand ginger needs MediumHigh force. Too little force keeps it closed;
      too much makes it harsh.
  - ruleId: L10_Process_Speed_Wrong
    priority: 25
    requiredCorrect:
    requiredIncorrect: 05000000
    hintText: Ginger needs Medium speed so the spice does not suddenly cover the
      sand ginger.
  - ruleId: L10_Process_Duration_Wrong
    priority: 20
    requiredCorrect:
    requiredIncorrect: 06000000
    hintText: The whole process has gone too long or not long enough. Protect the
      fresh scallion finish.
  - ruleId: L10_Process_All_Correct
    priority: 1
    requiredCorrect: 040000000500000006000000
    requiredIncorrect:
    hintText: Force, speed, and duration are in the target range. Submit the final
      aroma evaluation.
  fallbackHintText: No new experiment conclusion is available yet. Keep the parts
    that are already correct and adjust only one uncertain mechanic at a time.
  progressiveHintRules:
  - ruleId: L10_Hint_SandGinger_Ratio
    priority: 22
    mechanic: 2
    hintText: Sand ginger is the main body of the sauce and should have the highest
      ratio.
  - ruleId: L10_Hint_CoarseSalt_Ratio
    priority: 21
    mechanic: 2
    hintText: Coarse salt only supports the base, so it should stay at the lowest
      ratio.
  - ruleId: L10_Hint_Scallion_Ratio
    priority: 20
    mechanic: 2
    hintText: Scallion is light, but it should still be more visible than coarse
      salt to leave a fresh finish.
  - ruleId: L10_Hint_Ginger_Combination
    priority: 22
    mechanic: 3
    hintText: Sand ginger and ginger can be partly ground together so the two ginger
      aromas connect naturally.
  - ruleId: L10_Hint_Scallion_Combination
    priority: 21
    mechanic: 3
    hintText: Scallion is fragile. Keep it separate and handle it lightly instead
      of grinding it with ginger.
  - ruleId: L10_Hint_CoarseSalt_Combination
    priority: 20
    mechanic: 3
    hintText: Coarse salt can be crushed separately to form the salty base; it does
      not need to join the spice group.
  - ruleId: L10_Hint_CoarseSalt_Order
    priority: 22
    mechanic: 1
    hintText: Coarse salt should be crushed first to establish the base saltiness.
  - ruleId: L10_Hint_Ginger_Order
    priority: 21
    mechanic: 1
    hintText: Sand ginger should establish the main body first, then ginger joins
      in the middle.
  - ruleId: L10_Hint_Scallion_Order
    priority: 20
    mechanic: 1
    hintText: Scallion must be handled last so the bright green finish remains.
  successFeedback: Salt supports the base, sand ginger opens depth, ginger adds freshness,
    and scallion preserves the final green aroma.
  closeFeedback: The dipping sauce is close, but scallion, ginger grouping, or final
    order still needs adjustment.
  wrongFeedback: Ginger is too harsh, scallion is crushed, or salt steals the main
    role.
