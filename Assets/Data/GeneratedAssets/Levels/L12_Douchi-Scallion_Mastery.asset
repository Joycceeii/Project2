  fallbackHintText: No new hint for now. Every answer has appeared in an earlier recipe.
  progressiveHintRules:
  - ruleId: L12_Hint_Douchi_Ratio
    priority: 24
    mechanic: 2
    hintText: Recall the douchi recipe and use the Large amount for Yangjiang douchi.
  - ruleId: L12_Hint_Ginger_Ratio
    priority: 23
    mechanic: 2
    hintText: Use the Medium amount for ginger so it supports the douchi without replacing it.
  - ruleId: L12_Hint_Scallion_Ratio
    priority: 22
    mechanic: 2
    hintText: Use the Small amount for scallion white so its freshness stays controlled.
  - ruleId: L12_Hint_Salt_Ratio
    priority: 21
    mechanic: 2
    hintText: Use the Very Small amount for coarse salt. This is the same supporting role learned earlier.
  - ruleId: L12_Hint_Base_Combination
    priority: 24
    mechanic: 3
    hintText: "Yangjiang douchi and ginger belong in the same first batch; do not press New Batch between them."
  - ruleId: L12_Hint_Scallion_Combination
    priority: 23
    mechanic: 3
    hintText: Keep scallion white in its own batch so the savory base does not bury its fresh aroma.
  - ruleId: L12_Hint_Salt_Combination
    priority: 22
    mechanic: 3
    hintText: Keep coarse salt in a separate final batch.
  - ruleId: L12_Hint_Start_Order
    priority: 24
    mechanic: 1
    hintText: Begin with Yangjiang douchi and then add ginger to the same first batch.
  - ruleId: L12_Hint_Scallion_Order
    priority: 23
    mechanic: 1
    hintText: "After the savory base is complete, add scallion white in its own batch."
  - ruleId: L12_Hint_Salt_Order
    priority: 22
    mechanic: 1
    hintText: "Finish with coarse salt, following the same final seasoning rule used before."
  - ruleId: L12_Hint_Force
    priority: 19
    mechanic: 4
    hintText: Use Heavy force for the douchi-and-ginger batch to release the fermented bean's savory depth.
  - ruleId: L12_Hint_Speed
    priority: 20
    mechanic: 5
    hintText: Use Slow speed for the douchi-and-ginger batch so the savory base stays steady.
