  unlockCluesOnComplete:
  - clueId: L10_Douchi_Force
    title: Grinding Force - Process Clue
    content: "Use heavy force for this whole recipe. The fermented beans need clear pressure to release their savory depth."
    relatedIngredients: []
    relatedDimension: 4
  - clueId: L10_Douchi_Ratio
    title: Yangjiang Douchi - Ratio Clue
    content: Yangjiang douchi uses the Large amount so its savory flavor remains the strongest.
    relatedIngredients:
    - {fileID: 11400000, guid: 35cab88bfd23e2a4ba86da57c9d1e0de, type: 2}
    relatedDimension: 2
  - clueId: L10_Ginger_Speed
    title: Grinding Speed - Process Clue
    content: Use slow speed for this whole recipe. A slower grind keeps the savory flavor steady and prevents ginger and citrus from turning sharp.
    relatedIngredients: []
    relatedDimension: 5
  - clueId: L10_Ginger_Order
    title: Ginger - Order Clue
    content: "Ginger works well after the douchi flavor has formed, but before the dried tangerine peel arrives."
    relatedIngredients:
    - {fileID: 11400000, guid: 8bbe0982030adbe43bad85013e3c9400, type: 2}
    relatedDimension: 1
