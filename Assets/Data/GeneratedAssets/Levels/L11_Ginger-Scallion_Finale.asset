  - clueId: L11_Scallion_Order
    title: Scallion White - Order Clue
    content: "Scallion white follows the completed ginger batch in its own batch, before the final coarse salt."
    relatedIngredients:
    - {fileID: 11400000, guid: 90232a38a4c71eb4396c578d8b4122a9, type: 2}
