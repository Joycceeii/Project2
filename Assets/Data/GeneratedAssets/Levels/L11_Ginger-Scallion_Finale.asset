  progressiveHintRules:
  - ruleId: L11_Hint_SandGinger_Ratio
    priority: 22
    mechanic: 2
    hintText: Sand ginger should be the largest amount. It is the main ginger flavor.
  - ruleId: L11_Hint_CoarseSalt_Ratio
    priority: 21
    mechanic: 2
    hintText: Coarse salt should be the smallest amount. It should not taste salty.
  - ruleId: L11_Hint_Scallion_Ratio
    priority: 20
    mechanic: 2
    hintText: "Use more scallion white than coarse salt, but less than ginger."
  - ruleId: L11_Hint_Ginger_Combination
    priority: 22
    mechanic: 3
    hintText: Sand ginger and ginger can be ground together.
  - ruleId: L11_Hint_Scallion_Combination
    priority: 21
    mechanic: 3
    hintText: Keep scallion white separate from the ginger group.
  - ruleId: L11_Hint_CoarseSalt_Combination
    priority: 20
    mechanic: 3
    hintText: Grind coarse salt separately. It does not need to join the ginger group.
  - ruleId: L11_Hint_CoarseSalt_Order
    priority: 22
    mechanic: 1
    hintText: Start with coarse salt to set a light base.
  - ruleId: L11_Hint_Ginger_Order
    priority: 21
    mechanic: 1
    hintText: Add sand ginger before fresh ginger.
  - ruleId: L11_Hint_Scallion_Order
    priority: 20
    mechanic: 1
    hintText: Add scallion white last so it stays fresh.
