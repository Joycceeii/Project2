  unlockCluesOnComplete:
  - clueId: L01_Rice_Force
    title: Rice - Force Clue
    content: Rice works best with medium force. Too little force keeps it weak; too
      much can make it taste burnt.
    relatedIngredients:
    - {fileID: 11400000, guid: 9a1cd94e3dd91be4b88ca7f39f71ca64, type: 2}
    relatedDimension: 4
  fallbackHintText: No new hint for now. Keep what worked, and change only one thing
    on your next try.
  progressiveHintRules:
  - ruleId: L01_Hint_Force
    priority: 20
    mechanic: 4
    hintText: Rice does not need full force. Try setting the force near the middle
      of the slider.
